# Public base URL used in feeds, e.g. https://podcaster.example.org
BASE_URL=
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=
# Admin login. If either is empty the admin UI stays locked ("access not configured").
ADMIN_USER=
ADMIN_PASSWORD=
# Optional. If empty, a secret is generated once and stored in the database.
SESSION_SECRET=
# Token of the local worker (create it in the admin UI under Workers), used by
# `docker compose --profile worker up -d worker`.
WORKER_TOKEN=
